# === Required ===
ALLOWED_USER_ID=123456789
POSTGRES_URL=postgresql+asyncpg://user:pass@localhost:5432/teeshka
REDIS_URL=redis://localhost:6379/0
GEMINI_GATEWAY_URL=http://localhost:8080

# === LLM Provider (defaults available) ===
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=nvidia/nemotron-3-nano-30b-a3b
# LLM_TIMEOUT=30.0
# LLM_MAX_RETRIES=3

# === Required Secrets ===
TELEGRAM_BOT_TOKEN=your_bot_token
LLM_API_KEY=your_openrouter_key
GOOGLE_APPLICATION_CREDENTIALS_JSON=base64_encoded_json

# === E2E Tests (Optional) ===
# LLM_E2E_API_KEY=your_openrouter_key_for_tests

# === Optional Secrets ===
# QDRANT_API_KEY=
# NEO4J_PASSWORD=

# === Langfuse ===
LANGFUSE_PUBLIC_KEY=pk-lf-xxx
LANGFUSE_SECRET_KEY=sk-lf-xxx
# LANGFUSE_BASE_URL=https://langfuse.cloudnative.space

# === Langfuse E2E (teeshka-e2e project, for E2E tests) ===
# LANGFUSE_E2E_PUBLIC_KEY=pk-lf-xxx
# LANGFUSE_E2E_SECRET_KEY=sk-lf-xxx

# === Mem0 ===
# MEM0_API_URL=http://mem0.teeshka.svc.cluster.local:8080
# MEM0_API_KEY=

# === S3/MinIO ===
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# S3_ENDPOINT=http://cloudnative.space:9000
# S3_BUCKET=teeshka
# S3_REGION=us-east-1
# S3_PRESIGNED_TTL=3600
# S3_SMALL_FILE_THRESHOLD=102400

# === S3 E2E (teeshka-e2e bucket, for E2E tests) ===
# S3_E2E_ENDPOINT=http://cloudnative.space:9000
# S3_E2E_BUCKET=teeshka-e2e
# S3_E2E_ACCESS_KEY=
# S3_E2E_SECRET_KEY=

# === Context/Memory (defaults available) ===
# MODEL_CONTEXT_LIMIT=32768
# SUMMARIZATION_TRIGGER_RATIO=0.25
# USER_PROFILE_MAX_FACTS=5
# SLIDING_WINDOW_SIZE=20
# SUMMARIZATION_RECENT_MESSAGES=5
# SUMMARIZATION_MIN_NEW_MESSAGES=10

# === Security ===
# CONFIRMATION_TTL_MINUTES=5

# === Logging ===
# LOG_LEVEL=INFO
